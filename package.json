{
  "name": "sesame-lab",
  "version": "0.0.0",
  "private": true,
  "description": "Sesame Robot Emulator — emulator, virtual robot, and interactive engineering learning platform",
  "author": "Eric Zimmerman <contact@echozed.com>",
  "homepage": "https://echozed.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echozulucode/sesame-robot-emulator.git"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "validate:reproducibility": "node scripts/validate-reproducibility.mjs",
    "validate:hardware-map": "node scripts/validate-hardware-map.mjs --check-lines",
    "validate:joint-map": "node scripts/validate-joint-map.mjs",
    "build:source-annotations": "node scripts/build-source-annotations.mjs",
    "validate:source-annotations": "node scripts/validate-source-annotations.mjs",
    "build:lessons": "node scripts/build-lessons.mjs",
    "validate:lessons": "node scripts/validate-lessons.mjs",
    "build:joint-map": "node scripts/build-joint-map.mjs",
    "validate:calibration": "node scripts/validate-calibration.mjs",
    "build:calibration": "node scripts/build-calibration.mjs",
    "build:replay-fixture": "node scripts/build-replay-fixture.mjs",
    "validate:replay-fixture": "node scripts/build-replay-fixture.mjs --check",
    "extract:telemetry-literals": "node scripts/extract-telemetry-literals.mjs",
    "validate:telemetry-literals": "node scripts/extract-telemetry-literals.mjs --check",
    "verify:oled-hook": "node scripts/verify-oled-hook.mjs",
    "capture:viewer": "node scripts/capture-viewer-screenshots.mjs",
    "capture:web": "node scripts/capture-web-screenshots.mjs",
    "validate:assets-inventory": "node scripts/validate-assets-inventory.mjs",
    "validate:assembly-map": "node scripts/validate-assembly-map.mjs",
    "validate:gltf": "node scripts/validate-gltf.mjs",
    "demo:telemetry": "node emulator/bridge/dist/cli.js --replay emulator/bridge/fixtures/wave-pose.replay.jsonl --loop --serve-viewer",
    "dev": "node scripts/dev-lab.mjs",
    "dev:sim": "node scripts/dev-lab.mjs --backend sim",
    "dev:web": "pnpm --filter @sesame-lab/web dev",
    "demo:web": "node emulator/bridge/dist/cli.js --replay emulator/bridge/fixtures/wave-pose.replay.jsonl --loop --serve-viewer --viewer-dir apps/web/dist",
    "demo:qemu": "node packages/sesame-qemu/dist/cli.js --command wave",
    "build:qemu-image": "node emulator/qemu/build-qemu-images.mjs cli-oled",
    "build:qemu-image:no-oled": "node emulator/qemu/build-qemu-images.mjs cli",
    "probe:qemu-oled": "node emulator/qemu/probe-oled.mjs",
    "measure:qemu-connect": "node emulator/qemu/measure-connect.mjs --runs 25 --tag retry",
    "measure:qemu-flake": "node emulator/qemu/run-flake-trial.mjs --runs 20 --tag baseline"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.3"
  }
}
