{
  "name": "@sesame-lab/sesame-qemu",
  "version": "0.1.0",
  "private": true,
  "description": "QemuSesameRobot: the SesameRobot contract over real Sesame firmware executing under Espressif QEMU, commanded through the firmware's own serial CLI on UART0",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "import": "./dist/capabilities.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sesame-qemu": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run --testTimeout 600000 src/__tests__/contract.test.ts",
    "demo": "node dist/cli.js",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\""
  },
  "dependencies": {
    "@sesame-lab/sesame-model": "workspace:*",
    "@sesame-lab/sesame-protocol": "workspace:*",
    "@sesame-lab/sesame-sim": "workspace:*"
  },
  "devDependencies": {
    "@sesame-lab/sesame-api": "workspace:*",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
