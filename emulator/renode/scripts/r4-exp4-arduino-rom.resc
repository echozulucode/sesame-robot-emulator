:name: R4 / Experiment 4 rung C - minimal Arduino sketch, boot state + real ROM image
:description: Rung B plus Espressif's official ESP32-S2 mask ROM at 0x40000000, so
:description: every esp_rom_* / memcpy / libgcc call the runtime makes executes real
:description: ROM code instead of aborting the CPU.
:description:
:description:   node scripts/fetch-esp32s2-rom.mjs                      # once
:description:   node firmware/probes/build-r4-arduino.mjs               # once
:description:   node emulator/renode/tests/r4-run.mjs emulator/renode/scripts/r4-exp4-arduino-rom.resc r4-exp4-arduino-rom 120

using sysbus

mach create "r4-arduino-c"
machine LoadPlatformDescription @emulator/renode/platforms/esp32s2-sesame.repl
i @emulator/renode/scripts/r4-romimage.resc

logLevel 1
sysbus LoadELF @firmware/probes/build/r4-arduino-min.elf

echo ""
echo "### entry PC"
cpu PC

$entry = 0x40025504
i @emulator/renode/scripts/r4-bootstate.resc

emulation CreateServerSocketTerminal 3456 "uartsock" false
connector Connect uart0 uartsock

emulation RunFor "0.05"

echo ""
echo "### final PC"
cpu PC
echo "### executed instructions"
cpu ExecutedInstructions

quit
