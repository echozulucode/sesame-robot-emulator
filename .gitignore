# ---- dependencies -------------------------------------------------------
node_modules/
.pnpm-store/

# ---- portable toolchains (never machine-wide, never committed) ----------
tools/

# ---- pinned upstream checkout + build outputs ---------------------------
firmware/upstream/
firmware/artifacts/
/docs/findings/

# ---- build output -------------------------------------------------------
**/dist/
*.tsbuildinfo

# ---- rust / tauri build output (Phase 5) --------------------------------
# Cargo.lock IS committed: src-tauri is a binary crate and the installer has to
# be reproducible. `gen/schemas` is regenerated by tauri-build on every build.
src-tauri/target/
src-tauri/gen/schemas/

# ---- firmware binaries --------------------------------------------------
*.elf
*.bin
*.map

# ---- python -------------------------------------------------------------
.venv/
__pycache__/
*.pyc

# ---- vendored reference copy of upstream (read-only source of truth) ----
/reference/

# ---- editor / OS --------------------------------------------------------
.DS_Store
Thumbs.db

# NOTE: *.log is deliberately NOT ignored. Workstream R findings attach Renode
# logs as evidence; ignoring them would silently drop the proof.

# ---- R2/R3 probe build output (regenerable) -----------------------------
# Rebuild with: bash firmware/probes/build-probes.sh
# The reproducible per-image SHA-256s are recorded in
# docs/findings/R2-xtensa-execution-probe.md instead.
firmware/probes/build/

# ---- Renode execution traces (multi-MB, regenerable) --------------------
# The .log/.txt evidence next to them IS committed; only the raw PC traces are
# too large to be useful in git. Regenerate with:
#   node emulator/renode/tests/count-window-vectors.mjs
emulator/renode/tests/logs/*.trace


# Artifact of an early script-path bug: a literal directory whose name is a
# Windows path with the separators eaten. It held arduino-cli's installation
# id/secret. Removed from tracking 2026-09-02; the glob stops it recurring.
Projects*sesame-robot-emulator*
**/inventory.yaml

# Upstream firmware source, wherever a build output puts it. `**/dist/` already
# covers today's copy in apps/web/dist/upstream/, but the audit noted that a
# build landing outside that rule would publish upstream source by accident.
# Redistributing it is permitted (Apache-2.0, attributed in NOTICE) - the point
# is that this repo deliberately does not commit it, and the ignore set should
# make that true by construction rather than by where a tool happens to write.
**/sesame-firmware-main.ino
**/face-bitmaps.h
**/movement-sequences.h
**/captive-portal.h
