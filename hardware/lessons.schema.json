        "supersedes": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "module": { "$ref": "#/$defs/nonEmptyString" },
        "mainExperience": { "$ref": "#/$defs/nonEmptyString" },
        "realSesameConcept": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "type": "string", "enum": ["polished", "outline"] },
        "grounding": { "type": "string", "enum": ["factual", "conceptual"] },
        "groundingNote": { "type": ["string", "null"] },
        "conceptualReason": { "type": ["string", "null"] },
        "learningGoal": { "type": "string", "minLength": 20 },
        "willBeAbleTo": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "unlocks": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "estimatedMinutes": { "type": "integer", "minimum": 1 },
        "labHandoff": { "type": ["string", "null"] },
        "openQuestions": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "links": { "$ref": "#/$defs/links" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
        "challenges": { "type": "array", "items": { "$ref": "#/$defs/challenge" } }
      }
    }
  }
}
